+// ---- recording (`pacuda convert`) --------------------------------------------------------------
+//
+// While a thread records (`record`), every plan run that would go to the runner is encoded as for
+// a runner with sources, forms and symjit kernels on the device; its call is copied into the
+// recording, and the CPU then runs the plan (no runner is needed). The LC lanes add their
+// reductions of the run's amplitudes (`record_reduction`), and the result of the evaluation is
+// the CPU's, so a recording carries its own reference values.
+
+/// One plan run as the runner gets it: the program, the tables and the run lists, and the
+/// reductions of its amplitudes the caller made.
+#[derive(Clone, Debug, Default)]
+pub struct RecordedRun {
+    pub words: Vec<u64>,
+    pub width: [u8; 8],
+    pub current_planes: u32,
+    pub amplitude_planes: u32,
+    pub momentum_planes: u32,
+    pub scale_re: Vec<f64>,
+    pub scale_im: Vec<f64>,
+    pub factor_re: Vec<f64>,
+    pub factor_im: Vec<f64>,
+    /// (first plane, count) runs
+    pub upload_amplitude: Vec<u32>,
+    pub zero_amplitude: Vec<u32>,
+    pub download_amplitude: Vec<u32>,
+    /// the tile (planes of `stride` values) and this run's points
+    pub stride: u32,
+    pub points: u32,
+    /// the momentum forms from the external momenta (`pacman_recurrence_call`)
+    pub external_count: u32,
+    pub form_terms: Vec<u32>,
+    pub term_slots: Vec<u32>,
+    pub term_coefficients: Vec<f64>,
+    pub reductions: Vec<RecordedReduction>,
+}
+
+/// `output[point, helicity, color] += weight * fma(re, re, im * im)` of amplitude plane `plane`,
+/// in recording order.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct RecordedReduction {
+    pub plane: u32,
+    pub weight: f64,
+    pub helicity: u32,
+    pub color: u32,
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct Recording {
+    pub runs: Vec<RecordedRun>,
+    /// the symjit kernels, by SHA-256 of their plane applications: the kernel index of an op 14
+    /// word is a position here
+    pub symjit_sha256: Vec<String>,
+    /// why a plan run could not be recorded (the recording is then incomplete)
+    pub errors: Vec<String>,
+}
+
+thread_local! {
+    static RECORDING: std::cell::RefCell<Option<Recording>> = const { std::cell::RefCell::new(None) };
+}
+
+/// Runs `f` on this thread with the plan runs and their reductions recorded.
+pub fn record<R>(f: impl FnOnce() -> R) -> (R, Recording) {
+    RECORDING.with(|r| *r.borrow_mut() = Some(Recording::default()));
+    let result = f();
+    let recording = RECORDING.with(|r| r.borrow_mut().take()).unwrap_or_default();
+    (result, recording)
+}
+
+fn recording() -> bool {
+    RECORDING.with(|r| r.borrow().is_some())
+}
+
+fn record_error(message: String) {
+    RECORDING.with(|r| {
+        if let Some(recording) = r.borrow_mut().as_mut() {
+            recording.errors.push(message);
+        }
+    });
+}
+
+/// A reduction of the last recorded plan run's amplitude `plane` into output (helicity, color).
+pub(super) fn record_reduction(plane: u32, weight: f64, helicity: u32, color: u32) {
+    RECORDING.with(|r| {
+        if let Some(recording) = r.borrow_mut().as_mut() {
+            match recording.runs.last_mut() {
+                Some(run) => run.reductions.push(RecordedReduction { plane, weight, helicity, color }),
+                None => recording.errors.push("a reduction before any plan run".into()),
+            }
+        }
+    });
+}
