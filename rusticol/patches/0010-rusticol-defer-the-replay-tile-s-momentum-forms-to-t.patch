+        flags: (if keep { KEEP_AMPLITUDES } else { 0 }) | (if device_forms { FORMS_ON_DEVICE } else { 0 }),
+        external_momenta: std::ptr::null(),
+        external_count: 0,
+        term_count: 0,
+        form_terms: std::ptr::null(),
