+        deferred.borrow().as_ref().map(|forms| {
+            (forms.external, forms.sources, forms.slots.len() as u32, forms.form_terms.as_ptr(),
+             forms.slots.as_ptr(), forms.coefficients.as_ptr(), forms.points)
