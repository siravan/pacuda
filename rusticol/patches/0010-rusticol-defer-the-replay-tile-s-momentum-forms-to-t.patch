+
+/// The forms a replay tile deferred to the GPU (`defer_forms`): the external momenta
+/// (`[source][component][point]`, `points` per plane) and the selector's terms per form.
+struct DeferredForms {
+    external: *const f64,
+    external_len: usize,
+    sources: u32,
+    points: u32,
+    form_terms: Vec<u32>,
+    slots: Vec<u32>,
+    coefficients: Vec<f64>,
+}
+
+thread_local! {
+    static DEFERRED_FORMS: std::cell::RefCell<Option<DeferredForms>> =
+        const { std::cell::RefCell::new(None) };
+}
+
+/// Whether the runner fills the momentum forms (and the sources) on the device.
+pub(super) fn forms_on_device_available() -> bool {
+    matches!(runner(), Some(Ok(runner)) if runner.forms)
+}
+
+/// Defers this thread's next plan runs' momentum forms to the device. `external` must stay
+/// alive until `clear_deferred_forms` (the replay tile's call).
+pub(super) fn defer_forms(
+    external: &[f64],
+    sources: u32,
+    points: u32,
+    form_terms: Vec<u32>,
+    slots: Vec<u32>,
+    coefficients: Vec<f64>,
+) {
+    DEFERRED_FORMS.with(|deferred| {
+        *deferred.borrow_mut() = Some(DeferredForms {
+            external: external.as_ptr(),
+            external_len: external.len(),
+            sources,
+            points,
+            form_terms,
+            slots,
+            coefficients,
+        });
+    });
+}
+
+pub(super) fn clear_deferred_forms() {
+    DEFERRED_FORMS.with(|deferred| *deferred.borrow_mut() = None);
+}
+
+pub(super) fn deferred_forms_pending() -> bool {
+    DEFERRED_FORMS.with(|deferred| deferred.borrow().is_some())
+}
+
+/// The deferred forms on the CPU, as `fill_momentum_form_from_external` fills them (term order:
+/// `0.0 + c * p`, then `+= c * p`; no term: 0), when the plan run does not go to the GPU. They
+/// are no longer deferred afterwards.
+fn fill_deferred_forms_on_host(workspace: &mut DirectWorkspace<'_>) {
+    let Some(forms) = DEFERRED_FORMS.with(|deferred| deferred.borrow_mut().take()) else {
+        return;
+    };
+    // SAFETY: the replay tile that deferred the forms keeps `external` alive until it clears them
+    let external = unsafe { std::slice::from_raw_parts(forms.external, forms.external_len) };
+    let points = forms.points as usize;
+    let stride = workspace.point_stride as usize;
+    for (form, range) in forms.form_terms.chunks_exact(2).enumerate() {
+        let (first, count) = (range[0] as usize, range[1] as usize);
+        for component in 0..4 {
+            let start = (form * 4 + component) * stride;
+            let plane = &mut workspace.momenta[start..start + points];
+            if count == 0 {
+                plane.fill(0.0);
+                continue;
+            }
+            for term in first..first + count {
+                let (slot, coefficient) = (forms.slots[term] as usize, forms.coefficients[term]);
+                let input = &external[(slot * 4 + component) * points..][..points];
+                for (value, source) in plane.iter_mut().zip(input) {
+                    if term == first {
+                        *value = 0.0 + coefficient * source;
+                    } else {
+                        *value += coefficient * source;
+                    }
+                }
+            }
+        }
+    }
 }
 
