+/// The runner's kernel index and the binding of a symjit executor (`call`, `context`); an
+/// error names a kernel the runner was built without.
+fn symjit_executor(
+    call: usize,
+    context: *const std::ffi::c_void,
+) -> Result<Option<(u32, SymjitBinding)>, String> {
+    let Some(binding) = crate::engine::pacman_symjit::binding(call, context) else {
+        return Ok(None);
+    };
+    let Some(Ok(runner)) = runner() else {
+        return Ok(None);
+    };
+    match runner.symjit_index(&binding.sha256) {
+        Some(index) => Ok(Some((index, binding))),
+        None if runner.symjit_kernel.is_some() => Err(format!(
+            "the runner has no kernel for the symjit executor of application {}",
+            binding.sha256
+        )),
+        None => Ok(None),
+    }
+}
