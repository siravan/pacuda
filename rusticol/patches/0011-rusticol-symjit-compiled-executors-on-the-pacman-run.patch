+/// What the pacman recurrence runner needs of a symjit executor to run its rows (op 13 of
+/// `recurrence/direct_backend_pacman.rs`): the kernel (by the SHA-256 of its plane application)
+/// and its binding, as `execute_rows` applies it.
+#[cfg(feature = "pacman")]
+pub(crate) mod pacman {
+    use super::*;
+
+    /// One kernel input, in the kernel's input order (`parameter_bindings`).
+    #[derive(Clone, Copy, Debug, PartialEq)]
+    pub(crate) enum Input {
+        Parent { parent: u8, component: u16, imaginary: bool },
+        Momentum { operand: u8, component: u16 },
+        Destination { component: u16, imaginary: bool },
+        Parameter { index: u32, imaginary: bool },
+        Literal(f64),
+        ExactFactor { imaginary: bool },
+    }
+
+    #[derive(Clone, Debug, PartialEq)]
+    pub(crate) struct Binding {
+        pub(crate) sha256: String,
+        pub(crate) inputs: Vec<Input>,
+        /// per output pair (re, im): the destination current component it goes to
+        pub(crate) output_components: Vec<u16>,
+        /// a finalization that reads no current: with an exact factor of 1 its outputs are
+        /// written as they are (`direct_outputs_are_structurally_safe`)
+        pub(crate) direct_capable: bool,
+    }
+
+    /// The binding of the symjit contribution or finalization executor `call` (its entry point)
+    /// with `context`; `None` for other executors, or a binding the runner cannot express
+    /// (amplitude destinations, outputs not in re/im pairs of one destination component).
+    pub(crate) fn binding(call: usize, context: *const c_void) -> Option<Binding> {
+        let contribution = execute_contribution_rows as *const () as usize;
+        let finalization = execute_finalization_rows as *const () as usize;
+        if call != contribution && call != finalization || context.is_null() {
+            return None;
+        }
+        // SAFETY: a handle of these entry points carries its `SymjitDirectExecutorContext`
+        // (`LoadedSymjitDirectExecutor::handle`), alive as long as the executor catalog
+        let context = unsafe { &*context.cast::<SymjitDirectExecutorContext>() };
+        let plane = |projection: SymjitDirectPlaneProjection| match projection {
+            SymjitDirectPlaneProjection::ParentCurrent { parent, component, imaginary } => {
+                Some(Input::Parent { parent, component, imaginary })
+            }
+            SymjitDirectPlaneProjection::Momentum { operand, lorentz_component } => {
+                Some(Input::Momentum { operand, component: lorentz_component })
+            }
+            SymjitDirectPlaneProjection::DestinationCurrent { component, imaginary } => {
+                Some(Input::Destination { component, imaginary })
+            }
+            SymjitDirectPlaneProjection::DestinationAmplitude { .. } => None,
+        };
+        let mut inputs = Vec::with_capacity(context.parameter_bindings.len());
+        for binding in context.parameter_bindings.iter() {
+            inputs.push(match *binding {
+                SymjitDirectParameterBinding::Plane { index } => {
+                    plane(*context.input_planes.get(index as usize)?)?
+                }
+                SymjitDirectParameterBinding::Broadcast { index } => {
+                    match *context.scalars.get(index as usize)? {
+                        SymjitDirectScalarProjection::Parameter { index, imaginary } => {
+                            Input::Parameter { index, imaginary }
+                        }
+                        SymjitDirectScalarProjection::ExactFactor { imaginary } => {
+                            Input::ExactFactor { imaginary }
+                        }
+                        SymjitDirectScalarProjection::Literal(value) => Input::Literal(value),
+                    }
+                }
+            });
+        }
+        let mut output_components = Vec::new();
+        for pair in context.output_destinations.chunks_exact(2) {
+            let re = plane(*context.input_planes.get(pair[0] as usize)?)?;
+            let im = plane(*context.input_planes.get(pair[1] as usize)?)?;
+            match (re, im) {
+                (
+                    Input::Destination { component: a, imaginary: false },
+                    Input::Destination { component: b, imaginary: true },
+                ) if a == b => output_components.push(a),
+                _ => return None,
+            }
+        }
+        let direct_capable = context.role == DirectExecutorRole::Finalization
+            && !inputs
+                .iter()
+                .any(|input| matches!(input, Input::Parent { .. } | Input::Destination { .. }));
+        Some(Binding {
+            sha256: context.application_sha256.clone(),
+            inputs,
+            output_components,
+            direct_capable,
+        })
+    }
+}
