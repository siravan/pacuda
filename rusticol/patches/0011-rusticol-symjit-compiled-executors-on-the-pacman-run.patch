+type SymjitKernelFunction = unsafe extern "C" fn(*const std::ffi::c_char) -> i32;
+
+impl Runner {
+    /// The runner's index of the symjit kernel of this SHA-256 (hex), if it has it.
+    fn symjit_index(&self, sha256: &str) -> Option<u32> {
+        let lookup = self.symjit_kernel?;
+        let name = std::ffi::CString::new(sha256).ok()?;
+        // SAFETY: a NUL-terminated string, read during the call
+        let index = unsafe { lookup(name.as_ptr()) };
+        u32::try_from(index).ok()
+    }
+}
