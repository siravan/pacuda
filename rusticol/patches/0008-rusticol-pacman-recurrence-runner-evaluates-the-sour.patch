+/// The pacman recurrence runner's template code of a source row (`direct_backend_pacman.rs`,
+/// op 12): family (0 scalar, 1 Weyl, 2 Dirac, 3 vector) | orientation << 3 (particle 0,
+/// antiparticle 1) | (helicity + 2) << 5 | (chirality + 1) << 8, and its mass parameter.
+/// `None` when the runner does not evaluate it: another source executor (bound, union,
+/// cold-bound), a spin-2 or self-conjugate fermion source, an unknown domain.
+#[cfg(feature = "pacman")]
+pub(crate) fn pacman_source_template(
+    call: DirectSourceExecutor,
+    context: *const c_void,
+    row: &DirectSourceRow,
+) -> Option<(u32, Option<u32>)> {
+    let plain: DirectSourceExecutor = execute_direct_source_rows;
+    if call as usize != plain as usize || context.is_null() {
+        return None;
+    }
+    // SAFETY: `execute_direct_source_rows` is only paired with this context type
+    let context = unsafe { &*context.cast::<DirectSourceExecutorContext>() };
+    let template = context
+        .domains
+        .get(row.source_template_or_dispatch_domain as usize)?
+        .resolve(DirectSourceDispatchKey::SpinStateClass(row.spin_state_class))?;
+    let family = match template.family {
+        DirectSourceWavefunctionFamily::Scalar => 0,
+        DirectSourceWavefunctionFamily::WeylFermion => 1,
+        DirectSourceWavefunctionFamily::DiracFermion => 2,
+        DirectSourceWavefunctionFamily::Vector => 3,
+        DirectSourceWavefunctionFamily::Spin2 => return None,
+    };
+    let orientation = match template.orientation {
+        DirectSourceOrientation::Particle => 0,
+        DirectSourceOrientation::Antiparticle => 1,
+        DirectSourceOrientation::SelfConjugate if family == 0 || family == 3 => 0,
+        DirectSourceOrientation::SelfConjugate => return None,
+    };
+    if !(-2..=2).contains(&template.helicity) || !(-1..=1).contains(&template.chirality) {
+        return None;
+    }
+    let code = family
+        | orientation << 3
+        | ((template.helicity + 2) as u32) << 5
+        | ((template.chirality + 1) as u32) << 8;
+    Some((code, template.mass_parameter_index))
+}
